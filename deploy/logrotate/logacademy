# Ротация лога логинов nginx (его читает fail2ban).
# Файл пишет nginx-контейнер, поэтому copytruncate: файл обрезается на месте,
# дескриптор nginx остаётся валидным, перезапуск контейнера не нужен.
# Установка: sudo cp deploy/logrotate/logacademy /etc/logrotate.d/logacademy
/var/www/lms/logs/nginx-fail2ban/*.log {
    su root root
    weekly
    maxsize 20M
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
